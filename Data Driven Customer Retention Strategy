import pandas as pd
import numpy as np

from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

FEATURES = [
    "recency_days",
    "txn_count_90d",
    "avg_txn_value",
    "tenure_days",
    "web_sessions_30d",
    "app_sessions_30d",
    "support_contacts_90d",
    "promo_response_rate",
    "chargeback_flag",
]

def build_pipeline(k: int, random_state: int = 42) -> Pipeline:
    pre = ColumnTransformer(
        transformers=[
            ("num", StandardScaler(), FEATURES),
        ],
        remainder="drop",
        verbose_feature_names_out=False
    )

    model = KMeans(
        n_clusters=k,
        n_init="auto",
        random_state=random_state
    )

    pipe = Pipeline([
        ("preprocess", pre),
        ("kmeans", model),
    ])
    return pipe

def evaluate_k(df: pd.DataFrame, ks=range(2, 11)) -> pd.DataFrame:
    rows = []
    X = df[FEATURES].copy()

    for k in ks:
        pipe = build_pipeline(k)
        labels = pipe.fit_predict(df)
        # Need scaled data for silhouette
        X_scaled = pipe.named_steps["preprocess"].transform(df)
        sil = silhouette_score(X_scaled, labels)

        inertia = pipe.named_steps["kmeans"].inertia_
        rows.append({"k": k, "silhouette": sil, "inertia": inertia})

    return pd.DataFrame(rows)

def train_final(df: pd.DataFrame, k: int = 5) -> tuple[Pipeline, pd.DataFrame]:
    pipe = build_pipeline(k)
    labels = pipe.fit_predict(df)
    out = df.copy()
    out["cluster_id"] = labels
    return pipe, out

if __name__ == "__main__":
    df = pd.read_csv("data/customers_synth.csv")

    eval_df = evaluate_k(df, ks=range(2, 11))
    eval_df.to_csv("reports/k_selection_metrics.csv", index=False)
    print("Saved: reports/k_selection_metrics.csv")
    print(eval_df.sort_values("silhouette", ascending=False).head(5))

    pipe, clustered = train_final(df, k=5)
    clustered.to_csv("data/customers_clustered.csv", index=False)
    print("Saved: data/customers_clustered.csv")
    print(clustered["cluster_id"].value_counts().sort_index())





# src/profile_clusters.py
import pandas as pd

FEATURES = [
    "recency_days",
    "txn_count_90d",
    "avg_txn_value",
    "tenure_days",
    "web_sessions_30d",
    "app_sessions_30d",
    "support_contacts_90d",
    "promo_response_rate",
    "chargeback_flag",
]

# Simple rule-based naming (portfolio-friendly). Adjust to taste.
def name_cluster(row) -> str:
    if row["avg_txn_value"] >= 75 and row["txn_count_90d"] >= 12 and row["recency_days"] <= 14:
        return "VIP Loyalists"
    if row["avg_txn_value"] >= 75 and row["recency_days"] >= 45:
        return "At-Risk High Value"
    if row["promo_response_rate"] >= 0.65:
        return "Deal-Driven"
    if row["tenure_days"] <= 200 and row["txn_count_90d"] <= 6:
        return "New / Growing"
    return "Dormant / Low Engagement"

STRATEGY = {
    "VIP Loyalists": "Protect: perks, priority support, surprise-and-delight, reduce friction",
    "At-Risk High Value": "Win-back: proactive outreach, tailored incentive, remove blockers, concierge help",
    "Deal-Driven": "Personalize promos: offer timing, discount depth tests, channel optimization",
    "New / Growing": "Onboard: guided journey, education, early habit-forming nudges",
    "Dormant / Low Engagement": "Low-cost reactivation or suppress: light win-back, retargeting, cost control",
}

if __name__ == "__main__":
    df = pd.read_csv("data/customers_clustered.csv")

    profile = df.groupby("cluster_id")[FEATURES].mean().round(3)
    sizes = df["cluster_id"].value_counts().rename("cluster_size").sort_index()
    profile = profile.join(sizes)

    # Name clusters by profile
    profile["cluster_name"] = profile.apply(name_cluster, axis=1)
    profile["retention_strategy"] = profile["cluster_name"].map(STRATEGY)

    profile = profile.reset_index().sort_values("cluster_id")
    profile.to_csv("reports/cluster_profile.csv", index=False)

    print("Saved: reports/cluster_profile.csv")
    print(profile[["cluster_id", "cluster_name", "cluster_size", "retention_strategy"]])
